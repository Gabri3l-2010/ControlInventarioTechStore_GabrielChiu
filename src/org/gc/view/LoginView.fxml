<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="300.0" prefWidth="400.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.gc.controller.LoginController">
    <children>
        <Label layoutX="120.0" layoutY="30.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="TechStore Login" />
        <Label layoutX="60.0" layoutY="90.0" text="Usuario:" />
        <TextField fx:id="txtUsuario" layoutX="140.0" layoutY="85.0" prefWidth="180.0" />
        <Label layoutX="60.0" layoutY="140.0" text="Clave:" />
        <PasswordField fx:id="txtPassword" layoutX="140.0" layoutY="135.0" prefWidth="180.0" />
        <Button layoutX="160.0" layoutY="190.0" mnemonicParsing="false" onAction="#handleLogin" prefWidth="80.0" text="Ingresar" />
        <Label fx:id="lblError" layoutX="60.0" layoutY="240.0" prefWidth="280.0" textFill="RED" />
    </children>
</AnchorPane>
